# ایجاد .gitignore با محتوای صحیح
@"
# Dependencies
node_modules/
node-modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/
dist/

# Production logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files
.env
.env*.local
.env.production

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Misc
.cache/
"@ | Out-File -FilePath ".gitignore" -Encoding utf8